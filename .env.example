# Alpaca paper credentials.
# Replace these locally only with non-blank paper credential values.
# Never commit real values.
ALPACA_API_KEY=replace-with-paper-api-key
ALPACA_SECRET_KEY=replace-with-paper-secret-key

# Safety boundary. Keep this unset or false during the paper phase.
ALPACA_LIVE_TRADING_ENABLED=false

# Optional SDK endpoint override. Leave unset unless you explicitly need it.
# If set during this phase, it must point to the Alpaca paper endpoint, never live.
# APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Local paper runtime defaults.
TRADING_APP_FEED=IEX
TRADING_APP_OUTPUT_DIR=data/runtime
TRADING_APP_DASHBOARD_HOST=127.0.0.1
TRADING_APP_DASHBOARD_PORT=8765

# Optional comma-separated override. Leave blank for sector ETFs plus SPY.
TRADING_APP_SYMBOLS=
