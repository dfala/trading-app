# Server-only URL used by Next.js route handlers to reach the Python backend.
# Do not rename this to NEXT_PUBLIC_*; browser code should use same-origin /api/*.
TRADING_APP_BACKEND_URL=http://127.0.0.1:8765

# Optional absolute path to historical replay markdown reports.
# The launchd installer and Makefile set this to the repo-level data directory.
# TRADING_APP_REPLAY_REPORT_DIR=/absolute/path/to/trading/data/research/replay

# Optional absolute path to the shadow challenger observation journal
# (JSONL). Used to draw the Shadow Performance chart on the Models screen.
# TRADING_APP_SHADOW_JOURNAL=/absolute/path/to/trading/data/runtime/journal/shadow-challenger-observations.jsonl
